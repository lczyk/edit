\x1b[32m# Comments\x1b[m
\x1b[32m# Single-line comment\x1b[m

\x1b[32m=begin\x1b[m
\x1b[32mMulti-line\x1b[m
\x1b[32mcomment\x1b[m
\x1b[32m=end\x1b[m

\x1b[32m# Numbers\x1b[m
\x1b[92m42\x1b[m
\x1b[92m3.14\x1b[m
\x1b[92m0.5\x1b[m
\x1b[92m1e10\x1b[m
\x1b[92m1.5e-3\x1b[m
\x1b[92m0xff\x1b[m
\x1b[92m0xFF\x1b[m
\x1b[92m0b1010\x1b[m
\x1b[92m0o77\x1b[m
\x1b[92m1_000_000\x1b[m
\x1b[92m3.14r\x1b[m
\x1b[92m2i\x1b[m

\x1b[32m# Constants\x1b[m
\x1b[94mtrue\x1b[m
\x1b[94mfalse\x1b[m
\x1b[94mnil\x1b[m
\x1b[94mObject\x1b[m
\x1b[94mString\x1b[m

\x1b[32m# Strings\x1b[m
\x1b[91m'single quotes with escape: \' \n \t \\'\x1b[m
\x1b[91m"double quotes with escape: \" \n \t \\"\x1b[m
\x1b[91m`echo shell command`\x1b[m

\x1b[32m# Symbols and variables\x1b[m
\x1b[94m:symbol\x1b[m
\x1b[94m:method_name?\x1b[m
\x1b[96m@instance_var\x1b[m
\x1b[96m@@class_var\x1b[m
\x1b[96m$global_var\x1b[m

\x1b[32m# Control flow keywords\x1b[m
\x1b[95mif\x1b[m \x1b[94mtrue\x1b[m
  puts \x1b[91m"yes"\x1b[m
\x1b[95melsif\x1b[m \x1b[94mfalse\x1b[m
  puts \x1b[91m"no"\x1b[m
\x1b[95melse\x1b[m
  puts \x1b[91m"maybe"\x1b[m
\x1b[95mend\x1b[m

\x1b[95munless\x1b[m \x1b[94mnil\x1b[m
  puts \x1b[91m"not nil"\x1b[m
\x1b[95mend\x1b[m

\x1b[95mcase\x1b[m \x1b[92m42\x1b[m
\x1b[95mwhen\x1b[m \x1b[92m1\x1b[m
  puts \x1b[91m"one"\x1b[m
\x1b[95melse\x1b[m
  puts \x1b[91m"other"\x1b[m
\x1b[95mend\x1b[m

\x1b[95mfor\x1b[m i \x1b[95min\x1b[m \x1b[92m1\x1b[m..\x1b[92m3\x1b[m
  \x1b[95mnext\x1b[m \x1b[95mif\x1b[m i == \x1b[92m2\x1b[m
  \x1b[95mbreak\x1b[m \x1b[95mif\x1b[m i == \x1b[92m3\x1b[m
\x1b[95mend\x1b[m

\x1b[95mwhile\x1b[m \x1b[94mfalse\x1b[m
  \x1b[95mredo\x1b[m
\x1b[95mend\x1b[m

\x1b[95mbegin\x1b[m
  raise \x1b[91m"oops"\x1b[m
\x1b[95mrescue\x1b[m \x1b[94mStandardError\x1b[m => e
  \x1b[95mretry\x1b[m
\x1b[95mensure\x1b[m
  puts e
\x1b[95mend\x1b[m

\x1b[32m# Definitions and method calls\x1b[m
\x1b[95mmodule\x1b[m \x1b[94mDemo\x1b[m
  \x1b[95mclass\x1b[m \x1b[94mAnimal\x1b[m
    \x1b[95mdef \x1b[m\x1b[93minitialize\x1b[m(name)
      \x1b[96m@name\x1b[m = name
    \x1b[95mend\x1b[m

    \x1b[95mdef \x1b[m\x1b[93mspeak!\x1b[m =  puts \x1b[91m"#{@name} speaks"\x1b[m
  \x1b[95mend\x1b[m
\x1b[95mend\x1b[m

\x1b[94malias\x1b[m old_speak speak!
\x1b[94mundef\x1b[m old_speak

\x1b[94mBEGIN\x1b[m { puts \x1b[91m"start"\x1b[m }
\x1b[94mEND\x1b[m { puts \x1b[91m"finish"\x1b[m }
\x1b[94mdefined?\x1b[m \x1b[94mDemo\x1b[m
\x1b[94mself\x1b[m
\x1b[94msuper\x1b[m
\x1b[94myield\x1b[m

puts \x1b[91m"hello"\x1b[m
\x1b[94mArray\x1b[m.\x1b[93mnew\x1b[m(\x1b[92m3\x1b[m)
\x1b[93mgreet\x1b[m(\x1b[91m"world"\x1b[m)

\x1b[32m# Singleton method defs\x1b[m
\x1b[95mclass\x1b[m \x1b[94mFoo\x1b[m
  \x1b[95mdef self.\x1b[m\x1b[93mbar\x1b[m
    \x1b[92m42\x1b[m
  \x1b[95mend\x1b[m

  \x1b[95mdef Foo.\x1b[m\x1b[93mbaz\x1b[m
    \x1b[92m99\x1b[m
  \x1b[95mend\x1b[m
\x1b[95mend\x1b[m

\x1b[32m# Percent literals\x1b[m
words = \x1b[91m%w[one two three]\x1b[m
syms = \x1b[91m%i[a b c]\x1b[m
str_q = \x1b[91m%q(plain)\x1b[m
str_Q = \x1b[91m%Q{interp}\x1b[m

\x1b[32m# Character literals\x1b[m
ch_a = \x1b[92m?a\x1b[m
ch_z = \x1b[92m?Z\x1b[m
ch_esc = \x1b[92m?\n\x1b[m

\x1b[32m# Strings carry raw newlines, single- and double-quoted alike.\x1b[m
raw = \x1b[91m'line one\x1b[m
\x1b[91mline two'\x1b[m
esc = \x1b[91m"escaped \" quote\x1b[m
\x1b[91mline two"\x1b[m

\x1b[32m# Heredocs: squiggly, dashed, quoted, and plain. The rest of the opener line\x1b[m
\x1b[32m# is still code; the body starts on the next line.\x1b[m
sql = \x1b[91m<<~SQL\x1b[m.strip
\x1b[91m  SELECT * FROM users\x1b[m
\x1b[91m  WHERE name = 'SQL'\x1b[m
SQL
html = \x1b[91m<<-'HTML'\x1b[m
\x1b[91m    <p>#{not_interpolated}</p>\x1b[m
    HTML
plain = \x1b[91m<<EOS\x1b[m
\x1b[91mEOS mid-line stays body\x1b[m
EOS
puts sql

