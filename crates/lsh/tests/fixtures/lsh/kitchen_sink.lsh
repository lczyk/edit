// LSH definition example
#[display_name = "Demo"]
#[line_comment = "#"]
#[path = "**/*.demo"]
pub fn demo() {
    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /\d+/ {
            yield constant.numeric;
        }
    }
}

/* A block comment mentions a /path and some
   yield keyword.other; that is not code,
   and ends here. */
fn after_comment() {
    if /x/ { yield string; }
}
