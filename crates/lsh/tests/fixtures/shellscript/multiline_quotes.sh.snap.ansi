\x1b[32m#!/usr/bin/env bash\x1b[m
\x1b[32m# Quoted strings that span more than one line.\x1b[m

single=\x1b[91m'first\x1b[m
\x1b[91msecond'\x1b[m

ansi_c=\x1b[91m$'first\ttab\x1b[m
\x1b[91msecond'\x1b[m

double=\x1b[91m"first \x1b[m\x1b[96m$USER\x1b[m
\x1b[91msecond \x1b[m\x1b[96m${HOME}\x1b[m\x1b[91m"\x1b[m

backtick=\x1b[91m`uname -s\x1b[m
\x1b[91muname -r`\x1b[m

\x1b[32m# A jq program passed as a multi-line single-quoted argument.\x1b[m
jq \x1b[91m"\x1b[m\x1b[96m$FILTER\x1b[m\x1b[91m"\x1b[m\x1b[91m'\x1b[m
\x1b[91m    delpaths([ $prev[] | [.] ])\x1b[m
\x1b[91m    | . + ($base | slice($prev))\x1b[m
\x1b[91m    | . + $overlay'\x1b[m --argjson prev \x1b[91m"\x1b[m\x1b[96m$prev\x1b[m\x1b[91m"\x1b[m \x1b[91m"\x1b[m\x1b[96m$cfg\x1b[m\x1b[91m"\x1b[m

\x1b[32m# A backslash-escaped quote outside any string does not open one.\x1b[m
echo \x1b[91m'it'\x1b[m\'\x1b[91m's a trap'\x1b[m

\x1b[32m# Quotes inside a heredoc body are inert.\x1b[m
cat <<'EOF'
\x1b[91mdon't panic\x1b[m
EOF

echo \x1b[95mdone\x1b[m

\x1b[32m# Heredocs name their own terminator; `<<-` lets it hide behind tabs.\x1b[m
cat <<'SH'
\x1b[91mdon't panic, and SH mid-line is body\x1b[m
\x1b[91mSHx is body too\x1b[m
SH
cat <<-EOT | sort
\x1b[91m	indented body\x1b[m
	EOT
cat <<__END__
__END__
echo after heredocs

\x1b[32m# An unterminated quote runs to the end of the file.\x1b[m
echo \x1b[91m"no closing quote\x1b[m
\x1b[91mstill inside the string\x1b[m

