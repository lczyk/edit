  25 comment                # Rebase 3f9d2ab..d8c4b91 onto d8c4b91 (18 commands)
  26 comment                #
  27 comment                # Commands:
  28 comment                # p, pick <commit> = use commit
  29 comment                # r, reword <commit> = use commit, but edit the commit message
  30 comment                # e, edit <commit> = use commit, but stop for amending
  31 comment                # s, squash <commit> = use commit, but meld into previous commit
  32 comment                # f, fixup [-C | -c] <commit> = like "squash" but keep only the previous
  33 comment                #                    commit's log message, unless -C is used, in which case
  34 comment                #                    keep only this commit's message; -c is same as -C but
  35 comment                #                    opens the editor
  36 comment                # x, exec <command> = run command (the rest of the line) using shell
  37 comment                # b, break = stop here (continue rebase later with 'git rebase --continue')
  38 comment                # d, drop <commit> = remove commit
  39 comment                # l, label <label> = label current HEAD with a name
  40 comment                # t, reset <label> = reset HEAD to a label
  41 comment                # m, merge [-C <commit> | -c <commit>] <label> [# <oneline>]
  42 comment                #         create a merge commit using the original merge commit's
  43 comment                #         message (or the oneline, if no original merge commit was
  44 comment                #         specified); use -c <commit> to reword the commit message
  45 comment                # u, update-ref <ref> = track a placeholder for the <ref> to be updated
  46 comment                #                       to this position in the new commits. The <ref> is
  47 comment                #                       updated at the end of the rebase
  48 comment                #
  49 comment                # These lines can be re-ordered; they are executed from top to bottom.
  50 comment                #
  51 comment                # If you remove a line here THAT COMMIT WILL BE LOST.
  52 comment                #
  53 comment                # However, if you remove everything, the rebase will be aborted.
  54 comment                #
