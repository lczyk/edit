\x1b[32m# Rebase 3f9d2ab..d8c4b91 onto d8c4b91 (18 commands)\x1b[m
\x1b[32m#\x1b[m
\x1b[32m# Commands:\x1b[m
\x1b[32m# p, pick <commit> = use commit\x1b[m
\x1b[32m# r, reword <commit> = use commit, but edit the commit message\x1b[m
\x1b[32m# e, edit <commit> = use commit, but stop for amending\x1b[m
\x1b[32m# s, squash <commit> = use commit, but meld into previous commit\x1b[m
\x1b[32m# f, fixup [-C | -c] <commit> = like "squash" but keep only the previous\x1b[m
\x1b[32m#                    commit's log message, unless -C is used, in which case\x1b[m
\x1b[32m#                    keep only this commit's message; -c is same as -C but\x1b[m
\x1b[32m#                    opens the editor\x1b[m
\x1b[32m# x, exec <command> = run command (the rest of the line) using shell\x1b[m
\x1b[32m# b, break = stop here (continue rebase later with 'git rebase --continue')\x1b[m
\x1b[32m# d, drop <commit> = remove commit\x1b[m
\x1b[32m# l, label <label> = label current HEAD with a name\x1b[m
\x1b[32m# t, reset <label> = reset HEAD to a label\x1b[m
\x1b[32m# m, merge [-C <commit> | -c <commit>] <label> [# <oneline>]\x1b[m
\x1b[32m#         create a merge commit using the original merge commit's\x1b[m
\x1b[32m#         message (or the oneline, if no original merge commit was\x1b[m
\x1b[32m#         specified); use -c <commit> to reword the commit message\x1b[m
\x1b[32m# u, update-ref <ref> = track a placeholder for the <ref> to be updated\x1b[m
\x1b[32m#                       to this position in the new commits. The <ref> is\x1b[m
\x1b[32m#                       updated at the end of the rebase\x1b[m
\x1b[32m#\x1b[m
\x1b[32m# These lines can be re-ordered; they are executed from top to bottom.\x1b[m
\x1b[32m#\x1b[m
\x1b[32m# If you remove a line here THAT COMMIT WILL BE LOST.\x1b[m
\x1b[32m#\x1b[m
\x1b[32m# However, if you remove everything, the rebase will be aborted.\x1b[m
