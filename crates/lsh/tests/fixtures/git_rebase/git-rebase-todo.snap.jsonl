{"line":25,"kind":"comment","text":"# Rebase 3f9d2ab..d8c4b91 onto d8c4b91 (18 commands)"}
{"line":26,"kind":"comment","text":"#"}
{"line":27,"kind":"comment","text":"# Commands:"}
{"line":28,"kind":"comment","text":"# p, pick <commit> = use commit"}
{"line":29,"kind":"comment","text":"# r, reword <commit> = use commit, but edit the commit message"}
{"line":30,"kind":"comment","text":"# e, edit <commit> = use commit, but stop for amending"}
{"line":31,"kind":"comment","text":"# s, squash <commit> = use commit, but meld into previous commit"}
{"line":32,"kind":"comment","text":"# f, fixup [-C | -c] <commit> = like \"squash\" but keep only the previous"}
{"line":33,"kind":"comment","text":"#                    commit's log message, unless -C is used, in which case"}
{"line":34,"kind":"comment","text":"#                    keep only this commit's message; -c is same as -C but"}
{"line":35,"kind":"comment","text":"#                    opens the editor"}
{"line":36,"kind":"comment","text":"# x, exec <command> = run command (the rest of the line) using shell"}
{"line":37,"kind":"comment","text":"# b, break = stop here (continue rebase later with 'git rebase --continue')"}
{"line":38,"kind":"comment","text":"# d, drop <commit> = remove commit"}
{"line":39,"kind":"comment","text":"# l, label <label> = label current HEAD with a name"}
{"line":40,"kind":"comment","text":"# t, reset <label> = reset HEAD to a label"}
{"line":41,"kind":"comment","text":"# m, merge [-C <commit> | -c <commit>] <label> [# <oneline>]"}
{"line":42,"kind":"comment","text":"#         create a merge commit using the original merge commit's"}
{"line":43,"kind":"comment","text":"#         message (or the oneline, if no original merge commit was"}
{"line":44,"kind":"comment","text":"#         specified); use -c <commit> to reword the commit message"}
{"line":45,"kind":"comment","text":"# u, update-ref <ref> = track a placeholder for the <ref> to be updated"}
{"line":46,"kind":"comment","text":"#                       to this position in the new commits. The <ref> is"}
{"line":47,"kind":"comment","text":"#                       updated at the end of the rebase"}
{"line":48,"kind":"comment","text":"#"}
{"line":49,"kind":"comment","text":"# These lines can be re-ordered; they are executed from top to bottom."}
{"line":50,"kind":"comment","text":"#"}
{"line":51,"kind":"comment","text":"# If you remove a line here THAT COMMIT WILL BE LOST."}
{"line":52,"kind":"comment","text":"#"}
{"line":53,"kind":"comment","text":"# However, if you remove everything, the rebase will be aborted."}
