\x1b[32m#!/usr/bin/sed -nf\x1b[m
\x1b[32m# kitchen-sink sed fixture for lsh highlighting\x1b[m

\x1b[32m# strip leading whitespace\x1b[m
\x1b[94ms\x1b[m\x1b[91m/^[ \\t]*\x1b[m//

\x1b[32m# normalise tabs to two spaces, globally\x1b[m
\x1b[94ms\x1b[m\x1b[91m/\\t\x1b[m/\x1b[91m  \x1b[m/\x1b[94mg\x1b[m

\x1b[32m# print only lines matching FOO, then keep going\x1b[m
\x1b[91m/FOO/\x1b[m\x1b[94mp\x1b[m

\x1b[32m# delete blank lines\x1b[m
\x1b[91m/^$/\x1b[m\x1b[94md\x1b[m

\x1b[32m# range: from a marker to end-of-file\x1b[m
\x1b[91m/BEGIN/\x1b[m,\x1b[96m$\x1b[m \x1b[94m{\x1b[m
    \x1b[94ms\x1b[m\x1b[91m/old\x1b[m/\x1b[91mnew\x1b[m/\x1b[94m2gI\x1b[m
    s|alt-delim|won'\x1b[94mt\x1b[m be highlighted|\x1b[94mg\x1b[m
\x1b[94m}\x1b[m

\x1b[32m# transliterate vowels to uppercase via y command\x1b[m
\x1b[94my\x1b[m\x1b[91m/aeiou\x1b[m/\x1b[91mAEIOU\x1b[m/

\x1b[32m# numeric address + last-line\x1b[m
\x1b[92m1\x1b[m,\x1b[96m$\x1b[m \x1b[94m{\x1b[m
    \x1b[94m=\x1b[m
    \x1b[94mp\x1b[m
\x1b[94m}\x1b[m

\x1b[32m# label + branch\x1b[m
\x1b[94m:\x1b[mloop
\x1b[94mN\x1b[m
\x1b[94ms\x1b[m\x1b[91m/\\n\x1b[m/\x1b[91m, \x1b[m/\x1b[94mg\x1b[m
\x1b[94mt\x1b[m loop

\x1b[32m# backreferences in replacement\x1b[m
\x1b[94ms\x1b[m\x1b[91m/\\(foo\\)\\(bar\\)\x1b[m/\x1b[91m\\2-\\1\x1b[m/
\x1b[94ms\x1b[m\x1b[91m/whole\x1b[m/\x1b[91m[&]\x1b[m/\x1b[94mg\x1b[m

\x1b[32m# write the result to a file, then quit\x1b[m
\x1b[94mw\x1b[m out.txt
\x1b[94mq\x1b[m

\x1b[32m# a\\ i\\ c\\ take a text block; each line but the last ends in a backslash.\x1b[m
\x1b[94ma\x1b[m\\
\x1b[91m# not a comment, this is text\\\x1b[m
\x1b[91m123 s/x/y/ is text too\x1b[m
\x1b[94mi\x1b[m \x1b[91mtext on one line, GNU style\x1b[m
\x1b[91m/start/\x1b[m\x1b[94mc\x1b[m\\
\x1b[91mreplaced\x1b[m
\x1b[94mp\x1b[m

