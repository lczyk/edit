\x1b[32m// Function declaration with attribute\x1b[m
\x1b[93m__attribute__\x1b[m((deprecated))
\x1b[94mstatic\x1b[m \x1b[94minline\x1b[m \x1b[36mint\x1b[m \x1b[93mnob_cmd_run\x1b[m(Nob_Cmd *cmd, \x1b[36mbool\x1b[m async) {
