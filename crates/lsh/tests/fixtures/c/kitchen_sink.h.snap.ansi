    \x1b[95mdo\x1b[m { x++; } \x1b[95mwhile\x1b[m (x < \x1b[92m10\x1b[m);
    \x1b[95mfor\x1b[m (\x1b[36mint\x1b[m i = \x1b[92m0\x1b[m; i < \x1b[92m10\x1b[m; ++i) {
