    \x1b[95mfor\x1b[m (\x1b[36msize_t\x1b[m i = \x1b[92m0\x1b[m; i < cmd->count; ++i) {
        \x1b[93mprintf\x1b[m(\x1b[91m"%s "\x1b[m, cmd->items[i]);
    }
    \x1b[95mreturn\x1b[m \x1b[92m0\x1b[m;
}

\x1b[32m// Compound literal (C99)\x1b[m
Nob_Cmd empty_cmd = (Nob_Cmd){\x1b[92m0\x1b[m};

\x1b[32m// Control flow\x1b[m
\x1b[36mvoid\x1b[m \x1b[93mdemo\x1b[m(\x1b[36mint\x1b[m x) {
    \x1b[95mswitch\x1b[m (x) {
