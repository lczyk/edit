\x1b[32m# Single-line comment\x1b[m

\x1b[32m<#\x1b[m
\x1b[32mMulti-line\x1b[m
\x1b[32mcomment\x1b[m
\x1b[32m#>\x1b[m

\x1b[94mfunction\x1b[m \x1b[93mGet-SampleData\x1b[m {
    \x1b[94mparam\x1b[m(
        [string]\x1b[96m$Name\x1b[m = \x1b[91m"World"\x1b[m, \x1b[32m# String literal, parameter\x1b[m
        [int]\x1b[96m$Count\x1b[m = \x1b[92m3\x1b[m
    )

    \x1b[96m$array\x1b[m = @(\x1b[92m1\x1b[m, \x1b[92m2\x1b[m, \x1b[92m3\x1b[m) \x1b[32m# Array literal\x1b[m
    \x1b[96m$hashtable\x1b[m = @{ Key1 = \x1b[91m'Value1'\x1b[m; Key2 = \x1b[92m42\x1b[m } \x1b[32m# Hashtable literal\x1b[m

    \x1b[96m$nullVar\x1b[m = \x1b[94m$null\x1b[m
    \x1b[96m$boolTrue\x1b[m = \x1b[94m$true\x1b[m
    \x1b[96m$boolFalse\x1b[m = \x1b[94m$false\x1b[m

    \x1b[96m$regexMatch\x1b[m = \x1b[91m"abc123"\x1b[m -match \x1b[91m'\\d+'\x1b[m \x1b[32m# Regex literal\x1b[m

    \x1b[95mfor\x1b[m (\x1b[96m$i\x1b[m = \x1b[92m0\x1b[m; \x1b[96m$i\x1b[m -lt \x1b[96m$Count\x1b[m; \x1b[96m$i\x1b[m++) {
        \x1b[93mWrite-Host\x1b[m \x1b[91m"Hello, $Name! Iteration: $i"\x1b[m \x1b[32m# Variable interpolation, string\x1b[m
    }

    \x1b[95mif\x1b[m (\x1b[96m$hashtable\x1b[m.Key2 -eq \x1b[92m42\x1b[m) {
        \x1b[93mWrite-Output\x1b[m \x1b[91m"Hashtable value is 42"\x1b[m
    }
    \x1b[95melseif\x1b[m (\x1b[96m$hashtable\x1b[m.Key2 -gt \x1b[92m40\x1b[m) {
        \x1b[93mWrite-Output\x1b[m \x1b[91m"Hashtable value is greater than 40"\x1b[m
    }
    \x1b[95melse\x1b[m {
        \x1b[93mWrite-Output\x1b[m \x1b[91m"Hashtable value is less than or equal to 40"\x1b[m
    }

    \x1b[95mswitch\x1b[m (\x1b[96m$Name\x1b[m) {
        \x1b[91m"World"\x1b[m { \x1b[93mWrite-Host\x1b[m \x1b[91m"Default name used."\x1b[m }
        \x1b[95mdefault\x1b[m { \x1b[93mWrite-Host\x1b[m \x1b[91m"Custom name: $Name"\x1b[m }
    }

    \x1b[95mtry\x1b[m {
        \x1b[95mthrow\x1b[m \x1b[91m"An error occurred"\x1b[m
    }
    \x1b[95mcatch\x1b[m {
        \x1b[93mWrite-Warning\x1b[m \x1b[96m$_\x1b[m
    }
    \x1b[95mfinally\x1b[m {
        \x1b[93mWrite-Verbose\x1b[m \x1b[91m"Finally block executed"\x1b[m
    }

    \x1b[96m$script:globalVar\x1b[m = \x1b[92m99\x1b[m \x1b[32m# Scope modifier\x1b[m

    \x1b[32m# Here-String\x1b[m
    \x1b[96m$hereString\x1b[m = \x1b[91m@"\x1b[m
\x1b[91mThis is a here-string.\x1b[m
\x1b[91mName: $Name\x1b[m
\x1b[91m"@\x1b[m

    \x1b[95mreturn\x1b[m \x1b[96m$hereString\x1b[m
}

\x1b[32m# Command invocation, pipeline, splatting\x1b[m
\x1b[96m$paramSplat\x1b[m = @{
    Name  = \x1b[91m'PowerShell'\x1b[m
    Count = \x1b[92m2\x1b[m
}
\x1b[93mGet-SampleData\x1b[m \x1b[96m@paramSplat\x1b[m | \x1b[93mOut-File\x1b[m -FilePath \x1b[91m"./output.txt"\x1b[m

\x1b[32m# Type literal, member access, method call\x1b[m
[System.DateTime]::Now.ToString(\x1b[91m"yyyy-MM-dd"\x1b[m)

\x1b[32m# Subexpression\x1b[m
\x1b[93mWrite-Host\x1b[m \x1b[91m"2 + 2 = $($array[0] + $array[1])"\x1b[m

\x1b[32m# Command substitution\x1b[m
\x1b[96m$pwdPath\x1b[m = $(\x1b[93mGet-Location\x1b[m).Path
\x1b[93mWrite-Host\x1b[m \x1b[91m"Current directory: $pwdPath"\x1b[m

