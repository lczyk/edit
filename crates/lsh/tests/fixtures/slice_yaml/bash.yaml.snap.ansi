\x1b[94mpackage: \x1b[m\x1b[91mbash\x1b[m

\x1b[94messential:\x1b[m
  bash_copyright:

\x1b[94mslices:\x1b[m
  \x1b[93mconfig\x1b[m:
    \x1b[94mcontents:\x1b[m
      /etc/bash.bashrc:
      /etc/skel/.bash_logout:
      /etc/skel/.bashrc:
      /etc/skel/.profile:

  \x1b[93mbins\x1b[m:
    \x1b[94messential:\x1b[m
      bash_config:
      libc6_libs:
      libtinfo6_libs:
    \x1b[94mcontents:\x1b[m
\x1b[32m      # user should manually link /bin/sh to /bin/bash\x1b[m
      /usr/bin/bash:
      /usr/bin/clear_console:
      /usr/bin/rbash:

  \x1b[93mscripts\x1b[m:
    \x1b[94messential:\x1b[m
      bash_bashbug:

\x1b[32m  # bashbug is a script to send bug reports to the bash maintainers.\x1b[m
\x1b[32m  # in addition to stated essentials, it required $EDITOR to be set,\x1b[m
\x1b[32m  # and a working mail system. The script searches for the email client at,\x1b[m
\x1b[32m  # in order: /usr/lib/sendmail, /usr/sbin/sendmail, or rmail\x1b[m
  \x1b[93mbashbug\x1b[m:
    \x1b[94messential:\x1b[m
      base-files_bin:
      base-files_tmp:
      coreutils_cat:
      coreutils_chmod:
      coreutils_cp-bin:
      coreutils_mkdir:
      coreutils_sleep:
      coreutils_uname:
      dash_bins:
      diffutils_cmp:
      grep_bins:
      sed_bins:
    \x1b[94mcontents:\x1b[m
      /usr/bin/bashbug:

  \x1b[93mcopyright\x1b[m:
    \x1b[94mcontents:\x1b[m
      /usr/share/doc/bash/copyright:

