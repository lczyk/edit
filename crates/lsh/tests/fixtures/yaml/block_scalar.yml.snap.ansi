summary: \x1b[91mblock scalars with blank lines in the body\x1b[m

execute: |
\x1b[91m  set -eu\x1b[m

\x1b[91m  # A hash inside the body is script, not a yaml comment.\x1b[m
\x1b[91m  printf 'cols#80, lines#24\n' > "$rootfs/terminfo.src"\x1b[m

\x1b[91m  echo done\x1b[m

folded: >
\x1b[91m  first line\x1b[m

\x1b[91m  second paragraph\x1b[m
strip: |-
\x1b[91m  no trailing newline\x1b[m

\x1b[91m  still inside\x1b[m
nested:
  script: |

\x1b[91m    leading blank line\x1b[m
\x1b[91m    # another hash\x1b[m

\x1b[91m    trailing blank line\x1b[m

  sibling: \x1b[92m1\x1b[m
after: \x1b[92m2\x1b[m

