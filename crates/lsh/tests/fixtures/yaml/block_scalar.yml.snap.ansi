summary: [91mblock scalars with blank lines in the body[m

execute: |
[91m  set -eu[m

[91m  # A hash inside the body is script, not a yaml comment.[m
[91m  printf 'cols#80, lines#24\n' > "$rootfs/terminfo.src"[m

[91m  echo done[m

