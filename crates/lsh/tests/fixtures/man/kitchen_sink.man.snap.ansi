\x1b[94mEAT(1)                      General Commands Manual                     EAT(1)\x1b[m

\x1b[94mNAME\x1b[m
       eat - a syntax-highlighting cat

\x1b[94mSYNOPSIS\x1b[m
       eat [OPTIONS] [FILE]...

\x1b[94mDESCRIPTION\x1b[m
       eat prints the highlighted contents of FILEs. See also \x1b[33mcat(1)\x1b[m and
       \x1b[33mprintf(3p)\x1b[m for related tools.

\x1b[94mOPTIONS\x1b[m
       -A, \x1b[94m--show-all\x1b[m
              Show non-printable characters.

       -l, \x1b[94m--language\x1b[m <LANG>
              Override syntax detection.

       -p, \x1b[94m--plain\x1b[m
              Disable highlighting and decorations.

\x1b[94mENVIRONMENT VARIABLES\x1b[m
       EAT_PAGER
              The pager binary; falls back to \x1b[96m$PAGER\x1b[m, then less.

\x1b[94mEXAMPLES\x1b[m
       eat -l rust src/main.rs
       printf \x1b[91m'hello'\x1b[m | eat -l shellscript

\x1b[94mSEE ALSO\x1b[m
       \x1b[33mbat(1)\x1b[m, \x1b[33mcat(1)\x1b[m, \x1b[33mless(1)\x1b[m

