#[display_name = "Dockerfile"]
#[line_comment = "#"]
#[path = "**/Dockerfile"]
#[path = "**/Dockerfile.*"]
#[path = "**/*.Dockerfile"]
#[path = "**/*.dockerfile"]
#[path = "**/Containerfile"]
#[path = "**/Containerfile.*"]
pub fn dockerfile() {
    var one = 1;
    var env = 0;
    var continued = 0;

    if /#.*/ {
        yield comment;
        return;
    }

    if /(?i:ENV|LABEL|ARG)\>/ {
        yield keyword.control;
        env = 1;
    } else if /(?i:FROM|RUN|CMD|MAINTAINER|EXPOSE|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL)\>/ {
        yield keyword.control;
    }

    // A trailing backslash continues the instruction, so a continuation line
    // must not be dispatched as a fresh one -- a leading word that happens to
    // be an instruction name is still just an argument.
    loop {
        until /$/ {
            yield other;

            if /#.*/ {
                yield comment;
            } else if /\\$/ {
                continued = 1;
            } else if /(?i:AS|NONE|CMD|SHELL|CMD-SHELL)\>/ {
                yield keyword.other;
            } else if /"/ {
                until /$/ {
                    yield string;
                    if /\\./ {}
                    else if /\$(?:\{[^}]+\}|[A-Za-z_]\w*)/ {
                        yield variable;
                    }
                    else if /"/ { yield string; break; }
                }
            } else if /'/ {
                until /$/ {
                    yield string;
                    if /\\./ {}
                    else if /'/ { yield string; break; }
                }
            } else if /\$(?:\{[^}]+\}|[A-Za-z_]\w*)/ {
                yield variable;
            } else if /--[A-Za-z][\w-]*/ {
                yield keyword.other;
            } else if /([A-Za-z_][\w.-]*)\s*=/ {
                // `KEY=value` pairs name variables under ENV, LABEL and ARG.
                if env == one {
                    yield $1 as variable;
                }
                yield other;
            } else if /(?:true|false)\>/ {
                yield constant.language;
            } else if /(?:0x[\da-fA-F]+|\d+(?:\.\d+)?(?::\d+)?[a-zA-Z]*)\>/ {
                yield constant.numeric;
            } else if /\w+/ {
                // Gobble word chars to align next iteration on word boundary.
            }

            yield other;
        }

        if continued == one {
            continued = 0;
            await input;
        } else {
            break;
        }
    }
}
