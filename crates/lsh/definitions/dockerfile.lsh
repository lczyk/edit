#[display_name = "Dockerfile"]
#[line_comment = "#"]
#[path = "**/Dockerfile"]
#[path = "**/Dockerfile.*"]
#[path = "**/*.Dockerfile"]
#[path = "**/*.dockerfile"]
#[path = "**/Containerfile"]
#[path = "**/Containerfile.*"]
pub fn dockerfile() {
    if /#.*/ {
        yield comment;
        return;
    }

    if /(?i:ENV|LABEL|ARG)\>/ {
        yield keyword.control;
        if /\s+([A-Za-z_][\w.-]*)\s*=/ {
            yield $1 as variable;
            yield other;
        } else if /\s+([A-Za-z_][\w.-]*)/ {
            yield $1 as variable;
            yield other;
        }
    } else if /(?i:FROM|RUN|CMD|MAINTAINER|EXPOSE|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL)\>/ {
        yield keyword.control;
    }

    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /(?i:AS|NONE|CMD|SHELL|CMD-SHELL)\>/ {
            yield keyword.other;
        } else if /"/ {
            until /$/ {
                yield string;
                if /\\./ {}
                else if /\$(?:\{[^}]+\}|[A-Za-z_]\w*)/ {
                    yield variable;
                }
                else if /"/ { yield string; break; }
            }
        } else if /'/ {
            until /$/ {
                yield string;
                if /\\./ {}
                else if /'/ { yield string; break; }
            }
        } else if /\$(?:\{[^}]+\}|[A-Za-z_]\w*)/ {
            yield variable;
        } else if /--[A-Za-z][\w-]*/ {
            yield keyword.other;
        } else if /(?:true|false)\>/ {
            yield constant.language;
        } else if /(?:0x[\da-fA-F]+|\d+(?:\.\d+)?(?::\d+)?[a-zA-Z]*)\>/ {
            yield constant.numeric;
        } else if /\w+/ {
            // Gobble word chars to align next iteration on word boundary.
        }

        yield other;
    }
}
