#[display_name = "Rust"]
#[line_comment = "//"]
#[block_comment_open = "/*"]
#[block_comment_close = "*/"]
#[path = "**/*.rs"]
pub fn rust() {
    until /$/ {
        yield other;

        if /\/\/\/.*/ {
            yield comment;
        } else if /\/\/!.*/ {
            yield comment;
        } else if /\/\/.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /b?"/ {
            until /$/ {
                yield string;
                if /\\./ {}
                else if /"/ { yield string; break; }
                await input;
            }
        } else if /br?#+"/ {
            // Raw string. Not handling matching `#` count precisely.
            loop {
                yield string;
                if /"#+/ { yield string; break; }
                await input;
            }
        } else if /r#+"/ {
            loop {
                yield string;
                if /"#+/ { yield string; break; }
                await input;
            }
        } else if /b?'(?:\\.|[^'\\])'/ {
            yield string;
        } else if /'[a-zA-Z_]\w*/ {
            // Lifetime.
            yield keyword.other;
        } else if /#!?\[/ {
            // Attribute.
            loop {
                yield markup.link;
                if /\]/ { yield markup.link; break; }
                await input;
            }
        } else if /(?:as|async|await|break|continue|do|dyn|else|for|if|in|loop|match|move|return|try|while|yield)\>/ {
            yield keyword.control;
        } else if /(?:box|const|crate|enum|extern|fn|impl|let|mod|mut|pub|ref|self|Self|static|struct|super|trait|type|union|unsafe|use|where)\>/ {
            yield keyword.other;
        } else if /(?:true|false|None|Some|Ok|Err)\>/ {
            yield constant.language;
        } else if /(?i:-?(?:0x[\da-f_]+|0b[01_]+|0o[0-7_]+|[\d_]+\.?[\d_]*|\.[\d_]+)(?:e[+-]?[\d_]+)?)(?:[ui](?:8|16|32|64|128|size)|f(?:32|64))?/ {
            if /\w+/ {
                // Invalid numeric literal
            } else {
                yield constant.numeric;
            }
        } else if /(\w+)!/ {
            // Macro invocation.
            yield $1 as method;
        } else if /(?:bool|char|str|u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64|String|Vec|Option|Result|Box|Rc|Arc|Cell|RefCell)\>/ {
            // Primitive + std type names.
            yield variable;
        } else if /[A-Z][A-Za-z0-9_]*\>/ {
            // PascalCase type / variant catch-all.
            yield variable;
        } else if /(\w+)\(/ {
            // Function call.
            yield $1 as method;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
