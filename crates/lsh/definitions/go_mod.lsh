#[display_name = "Go Module"]
#[line_comment = "//"]
#[path = "**/go.mod"]
#[path = "**/go.work"]
pub fn go_mod() {
    until /$/ {
        yield other;

        if /\/\/.*/ {
            yield comment;
        } else if /(?:module|go|toolchain|godebug|require|replace|exclude|retract|tool|use)\>/ {
            yield keyword.other;
        } else if /=>/ {
            yield keyword.other;
        } else if /"[^"]*"/ {
            yield string;
        } else if /go\d[\w.+-]*\>/ {
            // toolchain arg, e.g. `go1.22.3`
            yield constant.numeric;
        } else if /v?\d[\w.+-]*\>/ {
            // module version `vX.Y.Z`, or the bare `go` directive version `X.Y`
            yield constant.numeric;
        } else if /[\[\],]/ {
            // Bracket/comma of a retract range -- consume alone so the version
            // that follows is seen at a field boundary, not glued to a `[`.
        } else if /\S+/ {
            // Gobble the whole non-space token (e.g. a module path) so an
            // embedded `.v3` isn't mistaken for a version field.
        }

        yield other;
    }
}
