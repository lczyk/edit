#[display_name = "Sparkle Bytecode"]
#[line_comment = "#"]
#[path = "**/*.sps"]
pub fn sps() {
    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /\.(?:fn|entry|string)\>/ {
            yield keyword.other;
        } else if /(\w+):/ {
            yield $1 as method;
        } else if /(arity|locals)\s*=/ {
            yield $1 as variable;
            yield other;
        } else if /"[^"]*"/ {
            yield string;
        } else if /(?:PUSH_INT|PUSH_FLOAT|PUSH_STR|PUSH_NIL|PUSH_BOOL|LOAD_LOCAL|STORE_LOCAL|LOAD_CAPTURE|MAKE_CLOSURE|CALL|PARTIAL_APPLY|RETURN|TAIL_CALL|MAKE_TUPLE|TUPLE_GET|UNPACK_TUPLE|PUSH_EMPTY_LIST|CONS|LIST_HEAD|LIST_TAIL|IS_EMPTY|MAKE_VARIANT|VARIANT_TAG|VARIANT_GET|UNPACK_VARIANT|JUMP_IF_FALSE|JUMP|MATCH_VARIANT|MATCH_INT|MATCH_LIST|ADD_INT|SUB_INT|MUL_INT|DIV_INT|REM_INT|ADD_FLOAT|SUB_FLOAT|MUL_FLOAT|DIV_FLOAT|INT_TO_FLOAT|INT_TO_STR|FLOAT_TO_STR|EQ|NEQ|LTE|LT|GTE|GT|AND|OR|NOT|STR_CONCAT|STR_SIZE|STR_STARTS_WITH|STR_SLICE_FROM|POP|DUP|PANIC)\>/ {
            yield support.function;
        } else if /-?(?:0x[\da-fA-F][\da-fA-F_]*|0b[01][01_]*|0o[0-7][0-7_]*|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?)\>/ {
            yield constant.numeric;
        } else if /\w+/ {
            // label refs / fn names -- gobble to word boundary
        }

        yield other;
    }
}
