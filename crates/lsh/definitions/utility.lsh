fn single_quote_string() {
    until /$/ {
        if /\\./ {
            // Escape sequences
        } else if /'/ {
            yield string;
            break;
        }
    }

    // Colours the remainder when the closing quote never arrives.
    yield string;
}

fn double_quote_string() {
    until /$/ {
        if /\\./ {
            // Escape sequences
        } else if /"/ {
            yield string;
            break;
        }
    }

    // Colours the remainder when the closing quote never arrives.
    yield string;
}
