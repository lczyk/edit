#[display_name = "Python"]
#[line_comment = "#"]
#[path = "**/*.py"]
#[path = "**/*.pyi"]
#[path = "**/*.pyw"]
#[shebang = "python"]
pub fn python() {
    var zero = 0;
    var force_string = 0;

    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /[a-zA-Z_]\w*'''/ {
            // Prefixed triple-quoted string (e.g. `f'''...'''`, `b'''...'''`).
            loop {
                yield string;
                if /'''/ { yield string; break; }
                await input;
            }
        } else if /[a-zA-Z_]\w*"""/ {
            // Prefixed triple-quoted string (e.g. `f"""..."""`, `r"""..."""`).
            loop {
                yield string;
                if /"""/ { yield string; break; }
                await input;
            }
        } else if /'''/ {
            if force_string == zero {
                loop {
                    yield comment;
                    if /'''/ { yield comment; break; }
                    await input;
                }
            } else {
                loop {
                    yield string;
                    if /'''/ { yield string; break; }
                    await input;
                }
            }
        } else if /"""/ {
            if force_string == zero {
                loop {
                    yield comment;
                    if /"""/ { yield comment; break; }
                    await input;
                }
            } else {
                loop {
                    yield string;
                    if /"""/ { yield string; break; }
                    await input;
                }
            }
        } else if /'/ {
            loop {
                if /[^'\\]+/ {}
                yield string;
                if /\\$/ {
                    // Backslash-newline continues the literal; anything else
                    // left open stops at the line end, as the language does.
                    await input;
                }
                else if /\\./ {}
                else if /'/ { yield string; break; }
                else { break; }
            }
        } else if /"/ {
            loop {
                if /[^"\\]+/ {}
                yield string;
                if /\\$/ {
                    // Backslash-newline continues the literal; anything else
                    // left open stops at the line end, as the language does.
                    await input;
                }
                else if /\\./ {}
                else if /"/ { yield string; break; }
                else { break; }
            }
        } else if /==|!=|<=|>=/ {
            // Comparison operators -- not assignment.
        } else if /=/ {
            // Assignment context: any following triple-quoted string is a real
            // string literal, not a standalone docstring / comment block.
            force_string += 1;
        } else if /(?:break|case|continue|elif|else|except|finally|for|if|match|pass|raise|return|try|while|with)\>/ {
            yield keyword.control;
        } else if /(?:and|assert|async|as|await|class|def|del|from|global|import|in|is|lambda|nonlocal|not|or|type|yield)\>/ {
            yield keyword.other;
        } else if /(?:True|False|None)\>/ {
            yield constant.language;
        } else if /(?i:-?(?:0x[\da-fA-F_]+|0b[01_]+|0o[0-7_]+|[\d_]+\.?[\d_]*|\.[\d_]+)(?:e[+-]?[\d_]+)?j?)/ {
            if /\w+/ {
                // Invalid numeric literal
            } else {
                yield constant.numeric;
            }
        } else if /@\w+/ {
            yield markup.link;
        } else if /(\w+)\s*\(/ {
            // Function / method call. The `(` opens a paren context, so any
            // triple-quoted string inside should be a real string literal.
            yield $1 as method;
            force_string += 1;
        } else if /\(/ {
            force_string += 1;
        } else if /\w+/ {
            // Gobble word chars to align the next iteration on a word boundary.
        }

        yield other;
    }
}
