// sed scripts. line-oriented stream-editor language: addresses,
// substitution (`s/.../.../[flags]`), translit (`y/.../.../`),
// single-letter commands, and labels. delimiters other than `/` (e.g.
// `s|...|...|`) are not modelled; everyone uses `/`.
#[display_name = "sed"]
#[line_comment = "#"]
#[path = "**/*.sed"]
#[shebang = "sed"]
pub fn sed() {
    var one = 1;
    var more = 0;

    until /$/ {
        yield other;

        if /#.*/ {
            yield comment;
        } else if /([aic])\\$/ {
            // Append / insert / change: the text follows on the next lines,
            // each one continued by a trailing backslash except the last.
            yield $1 as keyword.other;
            yield other;
            loop {
                await input;
                until /$/ {
                    if /[^\\]+/ {}
                    else if /\\$/ { more = 1; }
                    else if /\\./ {}
                }
                yield string;
                if more == one {
                    more = 0;
                } else {
                    break;
                }
            }
        } else if /([aic])[ \t]+/ {
            // GNU one-line form: the rest of the line is the text.
            yield $1 as keyword.other;
            yield other;
            if /.*/ {}
            yield string;
        } else if /(s)\// {
            yield $1 as keyword.other;
            // pattern half of `s/PATTERN/REPL/[flags]`
            until /$/ {
                yield string;
                if /\\./ {}
                else if /\// { yield other; break; }
            }
            // replacement half
            until /$/ {
                yield string;
                if /\\./ {}
                else if /\// { yield other; break; }
            }
            // flags: g (global), p (print), i/I (case), m/M (multi-line),
            // numeric Nth-match selector.
            if /[gpiImM0-9]+/ {
                yield keyword.other;
            }
        } else if /(y)\// {
            yield $1 as keyword.other;
            // source set of `y/SRC/DST/`
            until /$/ {
                yield string;
                if /\\./ {}
                else if /\// { yield other; break; }
            }
            // dest set
            until /$/ {
                yield string;
                if /\\./ {}
                else if /\// { yield other; break; }
            }
        } else if /\// {
            // standalone address regex `/PAT/`
            until /$/ {
                yield string;
                if /\\./ {}
                else if /\// { yield string; break; }
            }
        } else if /\\\d/ {
            // backreferences `\1` ... `\9` and `&` (handled below)
            yield variable;
        } else if /&/ {
            // whole-match reference in replacement -- typically inside the
            // s-replacement half, but appears here when it leaks out.
            yield variable;
        } else if /\$/ {
            // last-line address
            yield variable;
        } else if /-?\d+/ {
            yield constant.numeric;
        } else if /[abcdDgGhHilnNpPqQrRtTwWxz]\>/ {
            // single-letter sed commands. s and y handled above; their match
            // arms must precede this so the s/y prefix wins.
            yield keyword.other;
        } else if /[{}=:]/ {
            // grouping (`{` `}`), `=` (print line number), `:` (label intro).
            yield keyword.other;
        } else if /\w+/ {
            // gobble word chars (label names, etc.).
        }

        yield other;
    }
}
