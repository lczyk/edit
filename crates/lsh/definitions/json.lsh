#[display_name = "JSON"]
#[line_comment = "//"]
#[block_comment_open = "/*"]
#[block_comment_close = "*/"]
#[path = "**/*.json"]
#[path = "**/*.jsonc"]
#[path = "**/*.jsonl"]
#[path = "**/*.ndjson"]
pub fn json() {
    until /$/ {
        yield other;

        if /\/\/.*/ {
            yield comment;
        } else if /\/\*/ {
            loop {
                yield comment;
                await input;
                if /\*\// {
                    yield comment;
                    break;
                }
            }
        } else if /("[^"]*")\s*:/ {
            // Object key: quoted string followed by a colon. Keys with an
            // escaped quote fall through to json_string -- rare enough to skip.
            yield $1 as variable;
        } else if /"/ {
            json_string();
        } else if /true|false|null/ {
            if /\w+/ {
                // Not a keyword after all.
            } else {
                yield constant.language;
            }
        } else if /-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?/ {
            if /\w+/ {
                // Not a number after all.
            } else {
                yield constant.numeric;
            }
        } else if /\w+/ {
            // Invalid token? Skip.
        }

        yield other;
    }
}

fn json_string() {
    until /$/ {
        yield string;
        if /\\(?:u[0-9a-fA-F]{4}|.)/ {
            yield constant.character.escape;
        } else if /"/ {
            yield string;
            break;
        }
        await input;
    }
}
